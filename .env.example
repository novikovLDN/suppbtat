# ─── Telegram ───────────────────────────────────────────────
# Token from @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ─── Database ───────────────────────────────────────────────
# On Railway this is provided automatically by the Postgres plugin.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas?schema=public

# ─── Dashboard auth ─────────────────────────────────────────
# Secret used to sign JWT session tokens (use a long random string).
JWT_SECRET=change-me-to-a-long-random-string

# Bootstrap admin account (created/updated on every startup).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Administrator
# Telegram user id of the main admin. Enables the /admin command (one-tap login
# to the dashboard) for this user only.
ADMIN_TELEGRAM_ID=6214188086

# ─── Bot transport (polling vs webhook) ─────────────────────
# auto (default) = webhook when a public URL is known, else long polling.
BOT_MODE=auto
# Public HTTPS URL of this service. On Railway this is derived automatically
# from RAILWAY_PUBLIC_DOMAIN; set it explicitly only if you use a custom domain.
PUBLIC_URL=
# Optional: override the webhook secret (otherwise derived from BOT_TOKEN).
WEBHOOK_SECRET=

# ─── Branding ───────────────────────────────────────────────
BRAND_NAME=Atlas Secure
SUPPORT_BOT_USERNAME=
# Main product bot referenced in FAQ answers (payments, /profile, «Купить VPN»…)
MAIN_BOT_USERNAME=@atlassecure_bot

# ─── Working hours (for the "support is resting" notice) ─────
# Timezone (IANA), e.g. Europe/Moscow
SUPPORT_TZ=Europe/Moscow
# 24h format HH:MM. Leave WORK_HOURS_ENABLED=false to always be "online".
WORK_HOURS_ENABLED=true
WORK_HOURS_START=10:00
WORK_HOURS_END=22:00

# ─── Display ────────────────────────────────────────────────
# Ticket display numbers start around this value (#13102 etc.)
TICKET_NUMBER_OFFSET=13000

# ─── Web Push (operator notifications) ──────────────────────
# Generate once:  node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@atlas-secure.app

# ─── Animated custom emoji (optional) ───────────────────────
# Map names used in bot texts to Telegram custom_emoji ids:
# CUSTOM_EMOJI_JSON={"wave":"5368324170671202286","shield":"5379748062124056162"}
CUSTOM_EMOJI_JSON=

# ─── Server ─────────────────────────────────────────────────
# Railway sets PORT automatically.
PORT=3000
NODE_ENV=development
